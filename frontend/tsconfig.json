{
 "compilerOptions": {
  "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
  "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
  "strict": true, "noEmit": true, "isolatedModules": true,
  "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
  "noUnusedLocals": true, "noUnusedParameters": true, "types": ["vite/client", "node"]
 },
 "include": ["src", "vite.config.ts", "playwright.config.ts", "tests", "scripts"]
}
